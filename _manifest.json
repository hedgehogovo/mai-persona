{
  "manifest_version": 2,
  "version": "0.3.4",
  "name": "Mai Persona 内在引擎",
  "description": "维护 MaiBot 角色的情绪、生活节奏、事件线与关系状态，增强长期互动的连续拟人表现；不替代 MaiBot 自有人格、行为准则或回复风格。",
  "author": {
    "name": "Orxil.V",
    "url": "https://github.com/hedgehogovo"
  },
  "license": "MIT",
  "urls": {
    "repository": "https://github.com/hedgehogovo/mai-persona",
    "homepage": "https://github.com/hedgehogovo/mai-persona",
    "documentation": "https://github.com/hedgehogovo/mai-persona/blob/main/README.md",
    "issues": "https://github.com/hedgehogovo/mai-persona/issues"
  },
  "host_application": {
    "min_version": "1.3.0",
    "max_version": "1.3.99"
  },
  "sdk": {
    "min_version": "2.20.0",
    "max_version": "2.20.99"
  },
  "dependencies": [],
  "capabilities": [
    "knowledge.search",
    "message.get_by_id",
    "api.call",
    "send.text",
    "maisaka.proactive.trigger"
  ],
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": [
      "zh-CN"
    ]
  },
  "id": "mai-persona.mai-persona"
}
